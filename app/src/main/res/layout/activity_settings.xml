<?xml version="1.0" encoding="utf-8"?>
<!-- v3.8.3 redesign: follows the same conventions established on the
     Generate/Edit Answer Sheet Template screen — frozen header/title,
     frozen footer buttons, boxed cards with icon+label headers, round
     stepper buttons, pill toggles for fixed-choice RadioGroups. All view
     IDs unchanged, so SettingsActivity.kt needed no changes. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/exam_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:alpha="0.96" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- FROZEN header block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/btnOpenDrawer"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_menu"
                android:tint="?android:attr/textColorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open menu" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Settings"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="These apply to new answer sheet templates. Editing an existing test keeps its own saved values."
                android:textSize="12sp"
                android:alpha="0.75"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceCardStroke"
            android:alpha="0.6" />

        <!-- SCROLLABLE settings section -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- DEFAULTS card -->
            <LinearLayout
                android:id="@+id/cardDefaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_sliders"
                        android:tint="@color/tnhs_gold"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="TEMPLATE DEFAULTS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:alpha="0.85"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Default choices per question"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:textColor="?android:attr/textColorPrimary" />

                <RadioGroup
                    android:id="@+id/rgDefaultChoiceCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="4dp"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbDef4Choices"
                    android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:text="A–D (4)" />

                    <RadioButton
                        android:id="@+id/rbDef5Choices"
                    android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:text="A–E (5)" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Default number of questions"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:id="@+id/cardQuestionCountStepperSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="6dp"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btnDefQuestionCountMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="−" />

                    <EditText
                        android:id="@+id/etDefaultQuestionCount"
                        android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:inputType="number"
                        android:textColor="?android:attr/textColorPrimary" />

                    <Button
                        android:id="@+id/btnDefQuestionCountPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Default number of columns"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:id="@+id/cardColumnsStepperSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="6dp"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btnDefColumnsMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="−" />

                    <TextView
                        android:id="@+id/tvDefColumnsValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />

                    <Button
                        android:id="@+id/btnDefColumnsPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Default questions per column"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:id="@+id/cardRowsStepperSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="6dp"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btnDefRowsMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="−" />

                    <TextView
                        android:id="@+id/tvDefRowsValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />

                    <Button
                        android:id="@+id/btnDefRowsPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="+" />
                </LinearLayout>
            </LinearLayout>

            <!-- SCAN BEHAVIOR card -->
            <LinearLayout
                android:id="@+id/cardScanBehavior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_scan_action"
                        android:tint="@color/tnhs_gold"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="SCAN BEHAVIOR"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:alpha="0.85"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Auto-save scanned sheets"
                            android:textSize="14sp"
                            android:textColor="?android:attr/textColorPrimary" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Automatically saves each scanned sheet image when you tap Scan Next or Done, so you can review it later from Scanned Sheets."
                            android:textSize="11sp"
                            android:alpha="0.7"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAutosaveScan"
                        android:tag="accent_gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorSurfaceCardStroke"
                    android:alpha="0.6"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Camera sound"
                            android:textSize="14sp"
                            android:textColor="?android:attr/textColorPrimary" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Plays a shutter sound when you capture a sheet."
                            android:textSize="11sp"
                            android:alpha="0.7"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchCameraSound"
                        android:tag="accent_gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- v1.0.1: Parent/Guardian signature line toggle, per
                     explicit request — see SheetGenerator.drawParentSignatureLine
                     for what this actually draws on generated sheets. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Parent/Guardian signature line"
                            android:textSize="14sp"
                            android:textColor="?android:attr/textColorPrimary" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Adds a blank signature line below the scannable area on printed answer sheets. Not shown in previews, but present when printed."
                            android:textSize="11sp"
                            android:alpha="0.7"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchParentSignatureLine"
                        android:tag="accent_gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- v1.2.0: Classes feature switch (enrolled classes,
                     per-learner scores, ID row on new sheets). Off by
                     default. On a plan without access (Free / Quarter) the
                     switch is disabled and tapping the row opens
                     Subscription instead — see SettingsActivity. -->
                <LinearLayout
                    android:id="@+id/rowClassesEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Learner identification"
                            android:textSize="14sp"
                            android:textColor="?android:attr/textColorPrimary" />
                        <TextView
                            android:id="@+id/tvClassesEnabledHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Adds an ID row to newly generated answer sheets so each scan's score is saved to the right learner in your enrolled Classes."
                            android:textSize="11sp"
                            android:alpha="0.7"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchClassesEnabled"
                        android:tag="accent_gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- v1.2.0: number of ID digit boxes on newly generated sheets.
                     Same stepper look as the columns/rows steppers above.
                     4..12, default 6. Baked into each sheet's template when
                     the sheet is generated (see SheetTemplate.idDigits). -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Number of ID digits"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:id="@+id/cardIdDigitsStepperSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="6dp"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btnIdDigitsMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="−" />

                    <TextView
                        android:id="@+id/tvIdDigitsValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />

                    <Button
                        android:id="@+id/btnIdDigitsPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="4 to 12 digits (a DepEd LRN is 12). Applies to newly generated sheets; sheets you already printed keep the digit count they were made with."
                    android:textSize="11sp"
                    android:alpha="0.7"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <!-- STORAGE card -->
            <LinearLayout
                android:id="@+id/cardStorage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_image"
                        android:tint="@color/tnhs_gold"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="STORAGE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:alpha="0.85"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <!-- v3.6.1: scanned-sheet storage resolution, per explicit
                     request. Same pill-toggle pattern as choice-count
                     above, just 3 options instead of 2. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Scanned sheet storage resolution"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Long edge, in pixels, that a scanned sheet's saved photo is shrunk to. Lower uses less storage; higher stays more legible when zoomed in. Doesn't affect already-saved scans."
                    android:textSize="11sp"
                    android:alpha="0.7"
                    android:textColor="?android:attr/textColorPrimary" />

                <RadioGroup
                    android:id="@+id/rgStorageResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="4dp"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbRes2000"
                    android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:text="2000px" />

                    <RadioButton
                        android:id="@+id/rbRes1800"
                    android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:text="1800px" />

                    <RadioButton
                        android:id="@+id/rbRes1600"
                    android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:text="1600px" />

                    <!-- v1.0.1: 4th resolution option, per explicit request. -->
                    <RadioButton
                        android:id="@+id/rbRes1200"
                    android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:text="1200px" />
                </RadioGroup>
            </LinearLayout>

            <!-- FONT SIZE card. v3.9.9: system-wide UI text-size preference
                 — affects this app's own screens only (text sizes and
                 rounded-card padding), never the printed/PDF answer sheets
                 or their preview, which stay governed entirely by
                 SheetTemplate's fixed fractions. Same pill-toggle pattern
                 as choice-count/storage resolution above, 4 options. -->
            <LinearLayout
                android:id="@+id/cardFontSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_palette"
                        android:tint="@color/tnhs_gold"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="FONT SIZE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:alpha="0.85"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Text size for this app's own screens. Doesn't change printed or previewed answer sheets."
                    android:textSize="11sp"
                    android:alpha="0.7"
                    android:textColor="?android:attr/textColorPrimary" />

                <RadioGroup
                    android:id="@+id/rgFontScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="4dp"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbFontVerySmall"
                        android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:text="Very Small" />

                    <RadioButton
                        android:id="@+id/rbFontSmall"
                        android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="Small" />

                    <RadioButton
                        android:id="@+id/rbFontMedium"
                        android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:text="Medium" />

                    <RadioButton
                        android:id="@+id/rbFontLarge"
                        android:tag="accent_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_toggle_option"
                        android:textColor="@color/text_pill_toggle"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:text="Large" />
                </RadioGroup>
            </LinearLayout>

            <!-- v3.5: "Download paper size" row removed from here — it's now a
                 popup shown at GENERATE PDF time instead (see GenerateSheetActivity's
                 showPaperSizePickerThenGenerate()), so the teacher picks/confirms
                 it on every export instead of it being a background setting
                 that's easy to forget was ever changed. -->

            <!-- ACCENT COLORS card -->
            <LinearLayout
                android:id="@+id/cardAccentColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_palette"
                        android:tint="@color/tnhs_gold"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="ACCENT COLORS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:alpha="0.85"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <!-- Two independent popups, one per surface group — not a
                     single combined picker, since Group A (headers/status
                     bar) and Group B (buttons) are visually distinct
                     surfaces a teacher may want to recolor separately
                     (e.g. keep maroon headers but change button color to
                     match a school's other colors). -->
                <Button
                    android:id="@+id/btnAccentGroupA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Top Panel Accent"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_palette"
                    android:drawablePadding="10dp"
                    android:drawableTint="@android:color/white"
                    android:background="@drawable/bg_card_rounded"
                    android:backgroundTint="?attr/colorPrimary"
                    android:tag="accent_maroon"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btnAccentGroupB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Button Accent"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_palette"
                    android:drawablePadding="10dp"
                    android:drawableTint="@android:color/black"
                    android:background="@drawable/bg_card_rounded"
                    android:backgroundTint="?attr/colorAccent"
                    android:tag="accent_gold"
                    android:textColor="@android:color/black" />
            </LinearLayout>

        </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceCardStroke"
            android:alpha="0.6" />

        <!-- FROZEN footer block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- v3.7.2 fix: was a plain <Button> with drawableStart — same
                 icon-not-rendering issue documented elsewhere in this app
                 (drawableStart/drawableTint isn't reliable here, and the
                 accent system's generic Button branch doesn't touch
                 drawableTint anyway). Rebuilt as the same icon+text
                 LinearLayout row pattern used by Save This Template.
                 Kept the id btnSettingsSave and this block's own click
                 listener wiring in SettingsActivity.kt is by id, so no
                 Kotlin change was needed. -->
            <LinearLayout
                android:id="@+id/btnSettingsSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="?attr/colorPrimary"
                android:tag="accent_gold"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"
                    android:tint="@android:color/white"
                    android:tag="accent_gold_icon_on"
                    android:contentDescription="@null" />

                <!-- v3.7.6: switched accent_maroon -> accent_gold per
                     explicit request. Also briefly removed
                     textAllCaps="true" that round, since it was
                     rendering "Save Settings" as "SAVE SETTINGS" despite
                     Title Case source text — but v3.7.7 explicitly asked
                     for ALL CAPS across buttons app-wide, so
                     textAllCaps="true" is back, this time deliberately
                     rather than as an untouched leftover. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Save Settings"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:tag="accent_gold_text_on" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPlaceholderBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Back"
                android:textAllCaps="true"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="?attr/colorPrimary"
                android:tag="accent_maroon"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>
    </FrameLayout>

    <include
        layout="@layout/drawer_content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
