<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/exam_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:alpha="0.96" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/tnhs_maroon"
        android:tag="accent_maroon"
        android:padding="16dp">

        <!-- v3.7 fix: same maroon-on-maroon issue as Test Detail's header —
             see that layout's comment for the full explanation. -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_menu"
            android:tint="@android:color/white"
            android:tag="accent_maroon_icon_on"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open menu" />

        <TextView
            android:id="@+id/tvItemAnalysisTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Item Analysis"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:tag="accent_maroon_text" />
    </LinearLayout>

    <!-- v3.9.9 fix: reserves room for its own 2-line "has data" state
         (testName — folder / N scans analyzed...) so the 1-line "no data"
         state (just testName — folder) can't shrink this view and shift
         everything below it (folder-nav swipe row, table, Export button)
         up. Same reasoning as tvInlineSummary's minHeight fix in
         activity_test_detail.xml. textSize here isn't set explicitly
         elsewhere in this file so this assumes the default TextView size
         (~14sp-ish via the app theme); minHeight is sized generously
         enough to cover two lines at any of this app's normal text sizes. -->
    <TextView
        android:id="@+id/tvItemAnalysisSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:padding="16dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Not enough scored scans yet to run item analysis (need at least 2 with item-level data)."
        android:textColor="?android:attr/textColorPrimary"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/itemAnalysisScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/itemAnalysisTableContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </HorizontalScrollView>
    </ScrollView>

    <!-- v3.8.2: relocated here from directly under the header (was
         v3.7.8's original placement) — now sits BELOW the analysis
         result and ABOVE the Export button, per explicit request for
         thumb-reach access (same reasoning as Scanned Sheets' own
         folderNavRow position). The title above stays fixed at the top;
         only this row moved. Frozen either way — it was never inside the
         ScrollView above and still isn't, it's just lower in the same
         always-visible vertical stack. -->
    <LinearLayout
        android:id="@+id/folderNavRow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/btnFolderPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:tag="accent_maroon_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous folder" />

        <TextView
            android:id="@+id/tvFolderNavLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:alpha="0.7"
            android:textColor="?android:attr/textColorPrimary"
            android:text="" />

        <ImageView
            android:id="@+id/btnFolderNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_right"
            android:tag="accent_maroon_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next folder" />
    </LinearLayout>

    <!-- v1.1.1: opens CompetencySetupActivity — sits between the folder
         nav row above and the Export card below, per explicit request.
         Same maroon-secondary-action / gold-export-action convention as
         Scanned Sheets' own cards (Test Summary/Save List are maroon,
         Export is gold). -->
    <LinearLayout
        android:id="@+id/btnSetUpCompetencies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="?attr/colorPrimary"
        android:tag="accent_maroon"
        android:clipToOutline="true"
        android:elevation="2dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            android:tint="@android:color/white"
            android:tag="accent_maroon_icon_on"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Set Up Competencies"
            android:textAllCaps="true"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:tag="accent_maroon_text_on" />
    </LinearLayout>

    <!-- v3.7 fix: was a plain <Button> with android:drawableStart — same
         icon-not-rendering issue as Generate/Edit Template's buttons (see
         that layout file's comment for the full explanation). Converted
         to the same LinearLayout pattern so the icon reliably shows and
         centers together with the text. -->
    <LinearLayout
        android:id="@+id/btnExportItemAnalysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="?attr/colorAccent"
        android:tag="accent_gold"
        android:clipToOutline="true"
        android:elevation="2dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- v3.7 fix: same gold-on-gold issue as Test Detail's Scan Filled
             Answer Sheets card — parent is tagged accent_gold, so its icon
             and text need the _on variant for contrast instead of matching
             tags that made them invisible. -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_pdf_download"
            android:tint="@android:color/black"
            android:tag="accent_gold_icon_on"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Export"
            android:textAllCaps="true"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:tag="accent_gold_text_on" />
    </LinearLayout>
    </LinearLayout>
    </FrameLayout>

    <include
        layout="@layout/drawer_content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
