<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/exam_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:alpha="0.96" />

    <!-- v3.8 redesign: header + title and the two bottom action buttons are
         now OUTSIDE the ScrollView (frozen), matching the sample redesign
         proposal — a long template (many questions, wide layout options)
         used to push "Use This Template & Save Test" / "Generate PDF" off
         the bottom of the screen, or bury the hamburger/title under scrolled
         content. Only the middle configuration section scrolls now. All
         view IDs are unchanged from before, so GenerateSheetActivity.kt
         needed no changes. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- FROZEN header block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/btnOpenDrawer"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_menu"
                android:tint="?android:attr/textColorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open menu" />

            <TextView
                android:id="@+id/tvGenerateScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Generate Answer Sheet Template"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceCardStroke"
            android:alpha="0.6" />

        <!-- SCROLLABLE configuration section -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAutofill="noExcludeDescendants"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTestName"
                android:tag="accent_gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Test Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Number of Items"
                android:textSize="12sp"
                android:alpha="0.7"
                android:layout_marginTop="16dp" />

            <!-- Pill-style stepper row, wrapped in the shared rounded-card
                 background so the whole +/-/value control reads as one
                 grouped control, matching the sample's "Number of Items"
                 pill instead of three loose, unrelated-looking widgets. -->
            <LinearLayout
                android:id="@+id/cardQuestionCountStepper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="6dp"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnQuestionCountMinus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:textSize="18sp"
                    android:background="@drawable/bg_stepper_circle"
                    android:backgroundTint="?attr/colorPrimary"
                    android:tag="accent_maroon"
                    android:textColor="@android:color/white"
                    android:text="−" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etQuestionCount"
                    android:tag="accent_gold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:hint="Number of questions"
                    android:inputType="number" />

                <Button
                    android:id="@+id/btnQuestionCountPlus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:textSize="18sp"
                    android:background="@drawable/bg_stepper_circle"
                    android:backgroundTint="?attr/colorPrimary"
                    android:tag="accent_maroon"
                    android:textColor="@android:color/white"
                    android:text="+" />
            </LinearLayout>

            <!-- v3.8.3: pill toggle look, per explicit request — still a
                 real RadioGroup/RadioButton pair underneath (Kotlin's
                 checkedRadioButtonId/.check()/setOnCheckedChangeListener
                 logic in GenerateSheetActivity.kt is completely
                 unchanged), just re-skinned: android:button="@null" hides
                 the default circular marker, and each option's own
                 checked/unchecked pill fill comes from
                 bg_pill_toggle_option.xml's state selector rather than
                 the marker + label default RadioButton look. -->
            <RadioGroup
                android:id="@+id/rgChoiceCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_rounded"
                android:padding="4dp"
                android:layout_marginTop="16dp">

                <RadioButton
                    android:id="@+id/rb4Choices"
                    android:tag="accent_gold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_pill_toggle_option"
                    android:textColor="@color/text_pill_toggle"
                    android:textStyle="bold"
                    android:text="A–D"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb5Choices"
                    android:tag="accent_gold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_pill_toggle_option"
                    android:textColor="@color/text_pill_toggle"
                    android:textStyle="bold"
                    android:text="A–E" />
            </RadioGroup>

            <!-- LAYOUT card: boxed section with its own icon + label header,
                 matching the sample redesign proposal's "LAYOUT" card.
                 Columns / Questions per column / hint text are unchanged
                 functionally, just now visually grouped. -->
            <LinearLayout
                android:id="@+id/cardLayoutSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="16dp"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_layout_grid"
                        android:tint="@color/tnhs_gold"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="LAYOUT"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:alpha="0.85"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?android:attr/textColorPrimary"
                        android:text="Columns" />

                    <Button
                        android:id="@+id/btnColumnsMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="−" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etColumnsValue"
                        android:tag="accent_gold"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:inputType="number"
                        android:maxLines="1"
                        android:text="3" />

                    <Button
                        android:id="@+id/btnColumnsPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="+" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?android:attr/textColorPrimary"
                        android:text="Questions per column" />

                    <Button
                        android:id="@+id/btnRowsMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="−" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRowsValue"
                        android:tag="accent_gold"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:inputType="number"
                        android:maxLines="1"
                        android:text="10" />

                    <Button
                        android:id="@+id/btnRowsPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textSize="18sp"
                        android:background="@drawable/bg_stepper_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:tag="accent_maroon"
                        android:textColor="@android:color/white"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLayoutHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:alpha="0.7"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKeyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No answer key set yet"
                android:textSize="13sp"
                android:alpha="0.8"
                android:layout_marginTop="20dp" />

            <!-- v3.7 fix: was a plain <Button> with android:drawableStart —
                 across this screen those icons weren't actually rendering
                 (confirmed by the user on-device; XML drawableTint on a
                 vanilla Button's compound drawable isn't reliable here —
                 see BackButtonStyle.kt's comment for the one place that
                 IS proven working, via Kotlin's imperative
                 compoundDrawableTintList instead of XML). Converting to a
                 LinearLayout with an explicit ImageView also satisfies
                 "center icon and text together" — a Button's compound
                 drawable sits at a fixed edge inset with the text merely
                 centered in what's left, not truly centered as a unit
                 with the icon. tvCreateKeyLabel carries the id
                 GenerateSheetActivity.kt needs for the dynamic "Create
                 Answer Key" / "Edit Answer Sheet" text swap. -->
            <LinearLayout
                android:id="@+id/btnCreateKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="?attr/colorPrimary"
                android:tag="accent_maroon"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_document"
                    android:tint="@android:color/white"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvCreateKeyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Create Answer Key"
                    android:textAllCaps="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <!-- v3.7: was two side-by-side buttons (Blank Preview /
                 Answer Key Preview) — merged into one toggle per explicit
                 request. ivPreviewToggleIcon swaps between ic_eye_closed
                 (showing the blank sheet) and ic_eye (showing the answer
                 key filled in) on every tap; see
                 GenerateSheetActivity.togglePreview(). -->
            <LinearLayout
                android:id="@+id/btnPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="?attr/colorAccent"
                android:tag="accent_gold"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <!-- v3.7 fix: hardcoded black icon/text with no adaptivity
                     — parent is tagged accent_gold, so on a dark chosen
                     accent this would go invisible, same bug class as
                     Test Detail's Scan Filled Answer Sheets card. Fixed
                     with the _on contrast tags. Text also made all-caps
                     per request via textAllCaps (not a literal "PREVIEW"
                     string) so any future locale/casing change to the
                     underlying text stays consistent. -->
                <ImageView
                    android:id="@+id/ivPreviewToggleIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_eye_closed"
                    android:tint="@android:color/black"
                    android:tag="accent_gold_icon_on"
                    android:contentDescription="@null" />

                <!-- v3.7.4 fix: was 14sp, one size smaller than the other
                     footer/action buttons on this screen (e.g. "Save This
                     Template" at 15sp) despite being visually grouped with
                     them. Matched to 15sp for consistency. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Preview"
                    android:textAllCaps="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:tag="accent_gold_text_on" />
            </LinearLayout>

            <!-- v3.7.4: was 11sp — now matches the "Create Answer Key"
                 title text size (18sp) on AnswerKeyActivity, per explicit
                 request that this preview text follow that screen's text
                 size. -->
            <TextView
                android:id="@+id/tvPreviewNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:alpha="0.7"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#DDDDDD"
                android:layout_marginTop="8dp"
                android:padding="1dp">

                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="Answer sheet preview" />
            </FrameLayout>

        </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceCardStroke"
            android:alpha="0.6" />

        <!-- FROZEN footer block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/btnUseTemplate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="?attr/colorAccent"
                android:tag="accent_gold"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <!-- v3.7 fix: same hardcoded-black-with-no-adaptivity issue
                     as the Preview button above — parent is tagged
                     accent_gold, fixed with the _on contrast tags. Label
                     changed to "Save This Template" (all-caps via
                     textAllCaps) per request, replacing the two-line "Use
                     This Template & Save Test" — the Kotlin click listener
                     (findViewById(R.id.btnUseTemplate) -> useTemplate())
                     is unchanged, this is a label-only change. -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"
                    android:tint="@android:color/black"
                    android:tag="accent_gold_icon_on"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Save This Template"
                    android:textAllCaps="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/black"
                    android:tag="accent_gold_text_on" />
            </LinearLayout>

            <!-- v2.9: was two separate buttons (Generate & Share PDF /
                 Download PDF), merged into one — tapping this generates the
                 PDF once, then prompts Share vs Download vs Cancel. -->
            <LinearLayout
                android:id="@+id/btnGeneratePdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="?attr/colorPrimary"
                android:tag="accent_maroon"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_pdf_download"
                    android:tint="@android:color/white"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Generate PDF"
                    android:textAllCaps="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </FrameLayout>

    <include
        layout="@layout/drawer_content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
