<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Exam-day photo as a washed-out background: full-opacity image at the
             bottom, then a scrim using the theme's own window background color
             on top of it. Split into two scrim pieces (header band + rest) so
             the header area reads dimmer/more photo-visible while the list
             area below sits on a cleaner, more opaque surface.

             v2.8 fold-in fix: heights below (140dp / marginTop 140dp) are
             STALE — left over from before the header was pinned/
             restructured (two-line title, different padding), so the scrim
             band no longer actually matched the header's real height.
             Rather than re-guess a new fixed number (the same bug again,
             just a different wrong value), MainActivity now measures the
             header's REAL rendered height at runtime and resizes these two
             views to match exactly — see resizeScrimToMatchHeader() in
             MainActivity.kt. The 140dp values below only matter as the
             very first frame's fallback, before that measurement runs. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/exam_background"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:id="@+id/scrimTop"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="top"
            android:background="?android:attr/windowBackground"
            android:alpha="0.55" />

        <View
            android:id="@+id/scrimBottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="140dp"
            android:background="?android:attr/windowBackground"
            android:alpha="0.96" />

        <!-- Outer vertical container: fixed header row on top, scrolling list
             fills the rest via layout_weight. This replaces the old approach
             (header living as the first child inside the ScrollView, so it
             scrolled away with the list) — a pinned header needs to be a
             true sibling of the ScrollView, not a child of it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- App header panel: hamburger + logo/title on the left, Select
                 toggle + trash (bulk delete) on the right. Narrowed via side
                 margins (was edge-to-edge) so it reads as a distinct panel
                 rather than a full-width bar. Fixed here — does not scroll. -->
            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/btnOpenDrawer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_menu"
                    android:tint="?android:attr/textColorPrimary"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open menu" />

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/app_logo"
                    android:contentDescription="@string/app_name" />

                <!-- Two-line title: "MCQ" / "QUICK CHECK", each its own
                     TextView (not one TextView with \n) so each line can
                     have its own text size — "QUICK CHECK" needs to run
                     noticeably smaller than "MCQ" to fit without wrapping.
                     Sizes here (18sp / 9sp) are kept matching
                     drawer_content.xml's title sizes, per explicit
                     request, even though the drawer is narrower — that's
                     what forces "QUICK CHECK" down to 9sp here too.
                     Font (Press Start 2P) is NOT set via android:fontFamily
                     in this XML — see MainActivity.onCreate()'s comment
                     for why it has to be set on the Typeface in code
                     instead. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitleLine1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MCQ"
                        android:textSize="18sp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:id="@+id/tvHeaderTitleLine2"
                        android:layout_width="match_parent"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="5sp"
                        android:autoSizeMaxTextSize="9sp"
                        android:autoSizeStepGranularity="1sp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Project A.S.S.E.S.S"
                        android:textSize="9sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnToggleSelect"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="2dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Select tests" />

                <ImageView
                    android:id="@+id/btnDeleteSelected"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="12dp"
                    android:padding="2dp"
                    android:src="@android:drawable/ic_menu_delete"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete selected tests"
                    android:visibility="gone" />
            </LinearLayout>

        <!-- IMPORTANT: this ScrollView is declared BEFORE the footer below, not
             after — in a FrameLayout, later children draw on top and get touch
             priority in overlapping regions. With this the other way around,
             the ScrollView (spanning the full screen height) was silently
             swallowing taps on the footer's version number, even in its own
             bottom padding where nothing is visibly drawn. Preserved from the
             original home screen — same z-order bug class, same fix. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="56dp"
            android:importantForAutofill="noExcludeDescendants"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvSavedTestsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No saved tests yet — tap + to create one."
                    android:textSize="14sp"
                    android:alpha="0.75"
                    android:padding="16dp"
                    android:visibility="gone" />

                <!-- v3.1: title label above the test list, requested
                     separately from tvSavedTestsEmpty above (that's the
                     "nothing here yet" state; this is the list's own
                     section heading, shown whenever there's at least one
                     saved test — see MainActivity's list-population code
                     for the visibility toggle, same one already gating
                     tvSavedTestsEmpty vs savedTestsContainer). -->
                <TextView
                    android:id="@+id/tvSavedTestsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Saved Tests"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/savedTestsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        </LinearLayout>

        <!-- Fixed footer: version (tap for changelog) + developer credit, pinned
             to the bottom center of the screen rather than scrolling away with
             the content above it.

             v2.9: the real cause of the "footer looks faded" report was
             finally found — it was never this view's own alpha/textColor
             (both fix attempts in v2.8 addressed symptoms here and both
             were reported as still wrong). The Dark/Black themes simply
             never defined android:textColorPrimary, so every view using
             ?android:attr/textColorPrimary — this footer included — was
             inheriting MaterialComponents' translucent (~87% alpha)
             platform default instead of a solid color. Fixed once in
             themes.xml instead of here; see Theme.MCQScanner.Dark/.Black. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.0"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/developer_credit"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Big + FAB, bottom-right — add a test / generate a template.
             Bottom-END so it never overlaps the bottom-CENTER footer above. -->
        <TextView
            android:id="@+id/btnAddNewTest"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:text="＋"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:background="@drawable/fab_circle_background"
            android:backgroundTint="?attr/colorAccent"
            android:tag="accent_gold"
            android:elevation="6dp"
            android:contentDescription="Add a new test" />
    </FrameLayout>

    <!-- The drawer panel itself, slid in from the left. -->
    <include
        layout="@layout/drawer_content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
