<?xml version="1.0" encoding="utf-8"?>
<!-- Homescreen "Saved Tests" row card. Themed shape drawable — solid/
     stroke colors are resolved against whatever theme is active on the
     Activity (Light/Dark/Black) at draw time, since this is referenced via
     ?attr/colorSurfaceCard, not a hardcoded color. Deliberately NOT tagged
     for AccentColorPrefs (accent_gold/accent_maroon) — card color follows
     theme only, per explicit instruction, independent of the user's
     accent color choice. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceCard" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorSurfaceCardStroke" />
    <corners android:radius="16dp" />
</shape>
