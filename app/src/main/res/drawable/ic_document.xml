<?xml version="1.0" encoding="utf-8"?>
<!-- Plain document/list glyph for the Create/Edit Answer Key button.
     Outline-only (stroke paths, no solid fill) so it still reads correctly
     when uniformly tinted a single color via android:tint at use-site,
     since a solid-filled body would make any lines drawn on top of it
     invisible once both collapse to the same tint color. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M6,2.5 H14 L18.5,7 V21.5 H6 Z M14,2.5 V7 H18.5" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M8.5,11 H15 M8.5,14 H15 M8.5,17 H12.5" />
</vector>
